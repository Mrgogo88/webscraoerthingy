# LeadFinder configuration
# Copy this file to .env and adjust values as needed.

# Path to the SQLite database file
DATABASE_PATH=data/leads.db

# Directory where homepage screenshots are stored
SCREENSHOT_DIR=data/screenshots

# Overpass API endpoint (free, no key required)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim geocoding endpoint (free, no key required)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# User agent sent to OSM services (Nominatim requires an identifying UA)
OSM_USER_AGENT=LeadFinder/1.0 (local business audit tool)

# OPTIONAL: Google Places API key. When set, scans also pull businesses
# straight from Google Maps — including businesses with no website connected
# to their Google listing (prime leads). The API has a free monthly quota.
# Get a key: https://console.cloud.google.com/ -> enable "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Crawler settings
CRAWL_TIMEOUT_SECONDS=30
CRAWL_CONCURRENCY=3

# Lighthouse settings
LIGHTHOUSE_TIMEOUT_SECONDS=120

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/leadfinder.log
